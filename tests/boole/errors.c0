// error() and assert() are checks; strings are opaque values.
int checked_get(int[] A, int n, int i)
//@requires n == \length(A);
{
  if (i < 0 || i >= n) error("index out of range");
  return A[i];
}

int reachable_error(int x) {
  if (x < 0) error("negative");
  return x;
}

int unreachable_error(int x)
//@requires x > 0;
{
  if (x <= 0) error("impossible");
  assert(x != 0);
  return x;
}
