// `i <= 2147483647` wraps around to INT_MIN, so this loop reaches 0 and
// nozero(1) is false. The loop must not be read as a quantifier.
bool nozero(int lo) {
  for (int i = lo; i <= 2147483647; i++) {
    if (i == 0) return false;
  }
  return true;
}

// A smaller inclusive bound is still read as one.
bool positive(int[] A, int n)
//@requires 0 <= n && n < \length(A);
{
  for (int i = 0; i <= 9; i++)
  //@loop_invariant 0 <= i;
  {
    if (i <= n && A[i] <= 0) return false;
  }
  return true;
}

int main() {
  //@assert nozero(1);
  int[] A = alloc_array(int, 10);
  //@assert !positive(A, 3);
  return 0;
}
