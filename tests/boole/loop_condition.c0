// A loop condition with checks and calls is evaluated at the top of each iteration.
int get(int[] A, int i)
//@requires 0 <= i && i < \length(A);
{
  return A[i];
}

int first_zero(int[] A, int n)
//@requires n == \length(A);
//@ensures -1 <= \result && \result < n;
{
  int i = 0;
  while (i < n && get(A, i) != 0)
  //@loop_invariant 0 <= i && i <= n;
  {
    i++;
  }
  if (i == n) return -1;
  return i;
}
