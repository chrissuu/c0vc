// Field access through pointers, nested structs and arrays of structs.
struct inner { int a; bool b; };
struct outer { int tag; struct inner in; int[] data; };

int nested(struct outer* o)
//@requires o != NULL;
{
  o->in.a = 5;
  o->in.b = true;
  o->tag = 1;
  //@assert o->in.a == 5 && o->in.b;
  return o->in.a + o->tag;
}

int total(struct inner[] xs, int n)
//@requires 0 <= n && n <= \length(xs);
{
  int s = 0;
  for (int i = 0; i < n; i++)
  //@loop_invariant 0 <= i && i <= n;
  {
    if (xs[i].b) s += xs[i].a;
  }
  return s;
}

int first_data(struct outer* o)
//@requires o != NULL && \length(o->data) > 0;
{
  return o->data[0];
}
